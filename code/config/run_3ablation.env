# =============================================================================
# config/run_3ablation.env
#   scripts/run_3ablation.sh 배치에서 실제로 해석된(effective) 변수 스냅샷.
#   4계층(run_3ablation → run_groundcos_deep → run_groundcos_best → run_carry)의
#   env-override 기본값을 합성한 결과. 각 값 옆에 [출처] 표기.
#
#   용도:
#     source config/run_3ablation.env   # 이 프로파일을 셸에 로드
#   또는 재현:
#     env $(grep -vE '^\s*#|^\s*$' config/run_3ablation.env | xargs) \
#         bash scripts/run_3ablation.sh
#
#   ⚠ 이 파일은 정적 스냅샷 — 스크립트 기본값이 바뀌면 drift 가능.
#     생성 기준일: 2026-07-10 (run_3ablation.sh mtime 07-10 09:27)
# =============================================================================

# ── 배치 스윕 knobs [run_3ablation.sh 고정] ──────────────────────────────────
# ⚠ 전부 override형(${VAR:-default}): 이 env는 set -a; source 로 읽히므로 plain 대입
#    (VAR=값) 이면 명령줄에서 준 값을 덮어써 버린다(예: GROUND_TAUS=0.1 → 0.15 로 clobber).
#    override형이라야 "명령줄 > env default" 라는 주석의 약속이 실제로 성립.
TOP_K="${TOP_K:-5}"                     # 초기 ROI 후보 수 (deep 기본 10을 3ablation이 5로 덮음)
MAX_ITERATIONS="${MAX_ITERATIONS:-5}"   # carry 루프 최대 iteration
STEPS="${STEPS:-10}"                    # scanner=reasoner=verifier 단일 latent step
GROUND_TAUS="${GROUND_TAUS:-0.15}"      # ground_cos gate 임계 (단일 τ)
THUMBNAIL_NUM_GUIDES="${THUMBNAIL_NUM_GUIDES:-0}"   # thumbnail guide 비활성
MAX_ITEMS="${MAX_ITEMS:-}"              # empty = 전체(all). 스모크는 MAX_ITEMS=10
SCAN_ARGS="${SCAN_ARGS:---scan_pixel_floor}"   # run_one 이 EXTRA_ARGS 뒤에 append하는 기본 scan flag

# ── gate / loop [run_groundcos_best.sh 정본] ─────────────────────────────────
VERIFIER_GATE_SIGNAL=ground_cos   # cos(h*, vis_pool) 게이트 → --build_memory 자동 부착
MISSING_TARGET=kv_scan            # zoom headroom 소진 시 hidden-KV routing
ZOOM_TARGET=saliency_scan_crop    # ROI 재스캔 → cosine 위치
MISSING_SCORE=hidden
HIDDEN_SCORE_FN=cosine
ZOOM_MAGNIFICATION=40      # ⚠ fallback 전용. 실제 zoom은 아래 --zoom_fov snap 로
                           #   "한 피라미드 레벨 아래로 내려감"(zoom_level_step=1). 40× 아님.
                           #   snap 경로(scanner.py:865)에선 이 값 미사용.

# ── KV span 전달 [run_groundcos_best.sh] ─────────────────────────────────────
CARRY_KV_MODE=full         # 매 핸드오프 lossless carry
KV_MODE=full               # Diagnosis 진입 시 span
DIAG_KV_MODE=full          # Diagnosis decode 순간 (EXTRA_ARGS --diag_kv_mode 로 전달)
MEMORY_BANK=off            # lossless (carry_kv_mode!=full 과 배타)

# ── scanner [run_groundcos_best.sh] ──────────────────────────────────────────
SCANNER_METHOD=saliency    # hidden-cosine saliency scan
CROP_SIZE=512              # render long-side px
SCANNER_BOX_MULT=2         # FOV = crop_size * this = 1024px

# ── saliency score (Sal+Rel 1:1) [run_groundcos_best.sh] ─────────────────────
SAL_SOURCE=both            # both(=Sal+Rel) | rel | sal
SAL_LAM_R=1.0              # Rel 가중
SAL_LAM_S=1.0              # Sal 가중 (1:1)
SAL_HEAD_MODE=max          # LACO peak head 보존
SAL_HEAD_TOPK=4            # topk 모드 전용 (head_mode=max 에선 무시)
SAL_ROLE_TAG=question_choice
SAL_LAYER_MODE=mean        # mean(기본) | max(LACO)
SAL_POOL=2d
SAL_NORM=minmax
# → 조립되는 --saliency_* 플래그: source/lam_r/lam_s/head_mode/head_topk/
#   role_tag/qq_only=true/layer_mode/contrast=true/renorm=true/pool/norm

# ── KV pruning preset [run_groundcos_best.sh] ────────────────────────────────
PRUNE=off                  # 무손실 baseline (off|prefill_safe|safe|topk_b64r2|topk_b32|topk_b16)

# ── deep 변형 passthrough [run_groundcos_deep.sh → EXTRA_ARGS] ────────────────
#   --gate_vispool running_mean   iter>0 sufficiency anchor 매 append 갱신
#   --registry_rescore joint      매 iteration 전 crop 재점수 (piggyback q2v/l2v)

# ── inference.py 기본값 (run_carry가 env로 안 넘김) ───────────────────────────
#   ↓ 이 배치에서 "실제로 효력 있으나" 위 env로는 못 바꾸는 knob들.
#     값을 바꾸려면 EXTRA_ARGS="--zoom_fov ..." 처럼 직접 주입해야 함.
#   zoom_fov=snap            실제 zoom 방식: 한 피라미드 레벨 아래로 (배율↑)
#   zoom_level_step=1        snap 시 내려갈 레벨 수
#   zoom_rank=raw_score      zoom ROI 선택 순위
#   zoom_factor=2.0          (saliency_argmax 경로 전용, snap에선 미사용)
#   scanner_kv_thread=latent_only   scan_on_kv(=missing/rescan·zoom-reveal 경로)에서
#                                   append vision 버리고 latent thought만 carry.
#                                   ※ 첫 턴 아님! 첫 턴은 아래 thread_initial_scan.
#   thread_initial_scan=ON          첫 턴도 scan_on_kv로 → m(=STEPS) latent step 후
#                                   vision drop, latent keep → Reasoner가 그 위에 prefill.
#                                   inference.py 기본은 OFF지만 run_3ablation.sh 가
#                                   THREAD_INITIAL_SCAN=1(기본) 로 켜서 매 런에 주입
#                                   (20260710_191139 리포트 런과 동일). 끄려면 =0.
#   scanner_fov_mode=adaptive_center / scanner_fov_snap_levels=true
#   vision_inject=grounded   template-internal 마커 주입 (~25% visual)
#   realign_method=wa  realign_tau=1.0   W_a 재정렬
#   append_saliency=l2v      append crop saliency 소스

# ── 데이터 / 모델 [run_carry.sh 기본값, 이 배치에서 미변경] ──────────────────
DATASET=wsivqa
# override form (파일 헤더 규약과 일치): command-line MODEL_TYPE=... / MODEL_PATH=...
# 을 존중하도록 plain 대입에서 전환. 미지정 시 qwen3_vl 기본값 → 기존 배치는 byte-identical.
MODEL_TYPE="${MODEL_TYPE:-qwen3_vl}"
MODEL_PATH="${MODEL_PATH:-/media/super/4TB/hj/Qwen3-VL-4B-Thinking}"
TEST_JSON=/home/super/hj/HJ/WSI-VQA/dataset/WSI_captions/WsiVQA_test.json
SLIDE_DIR=/media/super/4TB/hj/DATA_SVS
WSI_DIR=/media/super/4TB/hj/DATA_SVS
CONDA_ENV=latentmas
CUDA_VISIBLE_DEVICES=0

# ── 그 외 run_carry 기본값 (이 배치에서 미변경) ──────────────────────────────
THUMBNAIL_SIZE=1024
SEGMENT_THUMBNAIL=false
SCANNER_RETRIES=10
SYNTHESIS_STEPS=0
L_MID_LAYERS=all
KV_CARRY=true
VERIFIER_DECISION=logit_gate
VERIFIER_SUFF_MARGIN=0.0
DIAGNOSIS_STRATEGY=legacy
DIAGNOSIS_DECODE=generate
DIAGNOSIS_SAMPLE=false
NO_MROPE=false
DIAGNOSIS_MAX_TOKENS=2048
THINK=false
SCANNER_THINK=false
REASONER_THINK=false
DIAGNOSIS_THINK=false
SAVE_VIZ=false
INSTRUCT=false
REASONER_STAGES=auto
MEM_B_ROI=8
MEM_B_KV=0
RUN_GENERAL_EVAL=true
GENERAL_EVAL_METRIC_SCOPE=both
# attn_realloc 기본값 (변형 3에서만 --attn_realloc 활성; 아래 변형 표 참조)
ATTN_REALLOC_ALPHA=0.15
ATTN_REALLOC_LAYERS=14-30
ATTN_REALLOC_RECIPIENT=all
ATTN_REALLOC_TOPK_FRAC=0.3
ATTN_REALLOC_WHERE=decode    # 변형 3은 both 로 덮음

# ── 출력 경로 [run_3ablation.sh / run_groundcos_best.sh] ─────────────────────
#   결과:   baseline_results/wsi-vqa/latentmas/<STAMP>_<name>/
#   중간이미지: IMG_BASE/<STAMP>[_<RUN_TAG>]/<RUN_ID>/
IMG_BASE=/media/super/4TB/hj/wsi-latentmas-carry

# =============================================================================
# 4개 변형별 차이 (--carry_prune, run_3ablation.sh run_one 인자)
#   변형은 EXTRA_ARGS 로만 갈리고 위 공통 config 는 동일.
#
#   [0] carryprune_none
#         --carry_prune none
#   [1] carryprune_topk               (우리 방법)
#         --carry_prune topk --carry_prune_delay 0 --prune_stream_mode gradual \
#         --prune_drop_per_event 300 --carry_prune_score accum
#   [2] carryprune_random             (동일 budget 무작위 victim)
#         --carry_prune random --carry_prune_delay 0 --prune_stream_mode gradual \
#         --prune_drop_per_event 300
#   [3] carryprune_topk_attnrealloc
#         --carry_prune topk --carry_prune_delay 0 --prune_stream_mode gradual \
#         --prune_drop_per_event 300 --carry_prune_score accum \
#         --attn_realloc --attn_realloc_where both
# =============================================================================
