# Shared runtime policy for Lingshu-I-8B and Patho-R1.
# Navigator is a compact control decode; terminal answers retain Qwen's BOXED surface.
export VLMAS_NAVIGATOR_CONTROL_TOKENS=96
export VLMAS_MAX_FORMAT_REPAIRS=0
export VLMAS_MAX_EXECUTION_RETRIES=0
export VLMAS_MAX_TERMINAL_REPAIRS=3
export VLMAS_ANSWERER_PROTOCOL=boxed
export VLMAS_CASE_RETRIES=0
export VLMAS_MAX_MODEL_LEN=16384
export SINGLE_OUTPUT_PROTOCOL=boxed
export SINGLE_DIRECT_FINAL_ONLY=1
export SINGLE_NATIVE_THINKING=false
export SINGLE_MAX_NEW_TOKENS=2048
